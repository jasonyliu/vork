# Foundry environment — machine-local, gitignored, written by provisions/install.
# Contract: specs/spec_foundry-interface.md §Environment. Every secret is a file path; Foundry reads the file and never the value from here.

# The owner account's token: your own GitHub account. Creates repositories, pushes the scaffold, applies rulesets, approves pull requests.
FOUNDRY_OWNER_TOKEN_PATH=<keystore>/github/owner.token
# The Vork account's token: the account every agent session commits and pushes as.
FOUNDRY_VORK_TOKEN_PATH=<keystore>/github/vork.token
# The Vork account's commit identity, bound to every founded clone as its starting
# identity; the actor working the clone sets its own (rules/PROJECT.md §Identity).
FOUNDRY_VORK_NAME=<name>
FOUNDRY_VORK_EMAIL=<email>
# The storage root: parent of every <project_key>/. ~/Vork/projects is the suggested default.
FOUNDRY_PROJECT_STORAGE_PATH=~/Vork/projects
