# Foundry environment — machine-local; contract in specs/data/spec_config.md §Foundry
FOUNDRY_OWNER_TOKEN_PATH=~/Vork/projects/keystore/github/jasonyliu-psyphix.token
FOUNDRY_WORK_TOKEN_PATH=~/Vork/projects/keystore/github/psyphix-main.token
FOUNDRY_RULESET=standard
FOUNDRY_PROJECT_STORAGE_PATH=~/Vork/projects
# registry connection — leave HOST unset to run standalone (scaffold, zero registry writes)
PSYPHIX_DATABASE_HOST=192.168.100.150
PSYPHIX_DATABASE_PORT=5432
PSYPHIX_DATABASE_NAME=psyphix
PSYPHIX_DATABASE_USER=psyphix_app
PSYPHIX_DATABASE_PASSWORD_PATH=~/Vork/projects/keystore/postgres/psyphix-app.password
