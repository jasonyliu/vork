# Foundry environment — machine-local, gitignored. Contract: specs/spec_foundry-interface.md §Environment.
# Every secret is a file path; Foundry reads the file and never the value from here.

# The owner account's token: your own GitHub account. Creates repositories, pushes the scaffold, applies rulesets, approves pull requests.
FOUNDRY_OWNER_TOKEN_PATH=<keystore>/github/owner.token
# The work account's token: the account every agent session commits and pushes as.
FOUNDRY_WORK_TOKEN_PATH=<keystore>/github/work.token
# standard | none. A free GitHub plan applies rulesets to public repositories alone.
FOUNDRY_RULESET=standard
# The storage root: parent of every <project_key>/. provisions/install writes it; ~/Vork/projects is the suggested default.
FOUNDRY_PROJECT_STORAGE_PATH=~/Vork/projects
