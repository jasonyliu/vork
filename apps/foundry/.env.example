# Foundry environment — specs/data/spec_config.md §Foundry. Deployment-local,
# gitignored, carried into each release worktree (deploy manual). Secrets are
# keystore paths, never values.

# The Principal's personal-account PAT — the owner of every bootstrapped project.
FOUNDRY_OWNER_TOKEN_PATH=<keystore>/github/owner.token
# Crew (main, heimdall, sarge) and specialist tokens resolve here as <name>.token.
FOUNDRY_AGENT_TOKEN_DIR=<keystore>/github/
# standard | none
FOUNDRY_RULESET=standard
# Parent of <project_key>/ — the same tree wakery's WAKERY_PROJECT_STORAGE_PATH names.
FOUNDRY_PROJECT_STORAGE_PATH=<project-storage-path>
# Wakery's public webhook endpoint and the HMAC secret it verifies with.
FOUNDRY_WEBHOOK_URL=https://<ingress-host>/adapters/github/webhook
FOUNDRY_WEBHOOK_SECRET_PATH=<keystore>/github/webhook_wakery

# Platform registry connection for the register stage (runtime role). Leave
# VORK_DATABASE_HOST unset to run standalone (no registry write).
VORK_DATABASE_HOST=<db-host>
VORK_DATABASE_PORT=5432
VORK_DATABASE_NAME=vork
VORK_DATABASE_USER=vork_app
VORK_DATABASE_PASSWORD_PATH=<keystore>/postgres/vork-app.password
