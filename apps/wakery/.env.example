WAKERY_HTTP_HOST=127.0.0.1
WAKERY_HTTP_PORT=4311
WAKERY_DATABASE_HOST=<db-host>
WAKERY_DATABASE_PORT=5432
WAKERY_DATABASE_USER=wakery
WAKERY_DATABASE_NAME=wakery
WAKERY_DATABASE_PASSWORD_PATH=<keystore>/postgres/wakery-app.password
WAKERY_GITHUB_WEBHOOK_SECRET_PATH=<keystore>/github/webhook_wakery
WAKERY_GITHUB_TOKEN_PATH=<keystore>/github/owner.token
WAKERY_OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
WAKERY_OPENCLAW_GATEWAY_TOKEN_PATH=<keystore>/openclaw/gateway-token
WAKERY_OPENCLAW_DEVICE_DIR=./var/openclaw-device
WAKERY_EVENT_LOG_DIR=./var/events
WAKERY_CONFIG_FILE=./config/wakery.json
WAKERY_PROJECT_STORAGE_PATH=<project-storage-path>
