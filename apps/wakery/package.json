{
  "name": "wakery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "tsx src/ingress/server.ts",
    "dev:worker": "tsx src/worker/worker.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx ../data/src/cli/migrate.ts",
    "seed": "tsx ../data/src/cli/seed.ts",
    "bootstrap:owner-route": "tsx src/scripts/bootstrap-owner-route.ts",
    "dev:github-fixture": "tsx src/scripts/send-github-fixture.ts",
    "smoke:db": "tsx src/scripts/smoke-db.ts",
    "smoke:openclaw": "tsx src/scripts/smoke-openclaw.ts",
    "smoke:dispatch-flow": "tsx src/scripts/smoke-dispatch-flow.ts",
    "inspect:recent": "tsx src/scripts/inspect-recent.ts",
    "inspect:run-session": "tsx src/scripts/inspect-run-session.ts",
    "reconcile:run-lease": "tsx src/scripts/reconcile-run-lease.ts",
    "cleanup:smoke": "tsx src/scripts/cleanup-smoke.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8",
    "@vork/data": "file:../data"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "pg-mem": "^3.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.20.0"
  }
}
