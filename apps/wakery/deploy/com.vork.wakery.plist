<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd user agent for the wakery process (ingress + the one dispatch worker).
  This file is a template: deploy/install.sh renders it into
  ~/Library/LaunchAgents/com.vork.wakery.plist, replacing
    @WAKERY_DIR@     the absolute path of this apps/wakery checkout
    @NODE_BIN_DIR@   the directory holding the node binary launchd should use
  Do not load this file unrendered.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vork.wakery</string>

    <key>WorkingDirectory</key>
    <string>@WAKERY_DIR@</string>

    <key>ProgramArguments</key>
    <array>
        <string>@WAKERY_DIR@/node_modules/.bin/tsx</string>
        <string>src/main.ts</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@NODE_BIN_DIR@:/usr/local/bin:/usr/bin:/bin</string>
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>@WAKERY_DIR@/var/logs/wakery.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>@WAKERY_DIR@/var/logs/wakery.stderr.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
